{
    admin off
    auto_https disable_redirects
    skip_install_trust
    servers {
        timeouts {
            read_header 10s
            read_body 30s
            write 160s
            idle 60s
        }
    }
}
https://localhost:8443 {
    tls internal
    request_body {
        max_size 6MB
    }
    reverse_proxy frontend:3000 {
        transport http {
            dial_timeout 5s
            response_header_timeout 155s
        }
    }
}
