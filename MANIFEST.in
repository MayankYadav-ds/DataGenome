include CHANGELOG.md CONTRIBUTING.md SECURITY.md
recursive-include examples *.py
recursive-include research *.md
recursive-include docs *.md
recursive-include benchmarks *.py

recursive-include tests *.py
recursive-include docs *.json

include frontend/package.json frontend/package-lock.json frontend/tsconfig.json
include frontend/*.ts frontend/*.mjs frontend/AGENTS.md frontend/.prettierignore
recursive-include frontend/app *.ts *.tsx *.css
recursive-include frontend/components *.tsx
recursive-include frontend/lib *.ts
recursive-include frontend/public *.json *.svg *.png
recursive-include frontend/tests *.ts *.tsx
prune frontend/node_modules
prune frontend/.next
prune frontend/test-results
prune frontend/playwright-report
recursive-include docs/screenshots *.png

recursive-include frontend/scripts *.mjs
include frontend/.env.example

exclude frontend/next-env.d.ts
